            <!-- Email template for new users -->
            <record id="set_password_email" model="mail.template">
                <field name="name">ERP Mayapada Healthcare: New registration user</field>
                <field name="model_id" ref="base.model_res_users"/>
                <field name="email_from"><![CDATA["ERP Odoo Mayapada Healthcare" <odoo@mayapadahospital.com>]]></field>
                <field name="email_cc">it.odoo@mayapadahospital.com</field>
                <field name="email_to">${object.email|safe}</field>
                <field name="subject"><![CDATA[ERP Mayapada Healthcare invitation to connect on Odoo]]></field>
