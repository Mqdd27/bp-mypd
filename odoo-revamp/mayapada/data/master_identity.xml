<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_position_master_identity_form" model="ir.ui.view">
            <field name="name">res.position.master.identity.form</field>
            <field name="model">res.position</field>
            <field name="inherit_id" ref="mayapada_res_position_inherited"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="position_code"/>
                </field>
                <field name="name" position="after">
                    <field name="alias_name"/>
                </field>
            </field>
        </record>

        <record id="view_res_position_master_identity_tree" model="ir.ui.view">
            <field name="name">res.position.master.identity.tree</field>
            <field name="model">res.position</field>
            <field name="arch" type="xml">
                <tree string="Job Positions">
                    <field name="position_code"/>
                    <field name="name"/>
                    <field name="alias_name"/>
                    <field name="department_id"/>
                    <field name="parent_id"/>
                </tree>
            </field>
        </record>

        <record id="view_res_users_master_identity_form" model="ir.ui.view">
            <field name="name">res.users.master.identity.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="mayapada_res_users_inherited"/>
            <field name="arch" type="xml">
                <field name="emp_code" position="after">
                    <!-- <field name="user_code"/> -->
                    <field name="alias_name"/>
                    <field name="sipa_no"/>
                </field>
            </field>
        </record>

        <record id="view_res_users_master_identity_tree" model="ir.ui.view">
            <field name="name">res.users.master.identity.tree</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <field name="login" position="before">
                    <!-- <field name="user_code"/> -->
                </field>
                <field name="name" position="after">
                    <field name="alias_name" optional="show"/>
                    <field name="sipa_no" optional="show"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
