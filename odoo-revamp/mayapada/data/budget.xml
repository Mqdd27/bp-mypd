    <record id="mayapada_budget_exceed_form_inherited" model="ir.ui.view">
            <field name="name">budget.exceed</field>
            <field name="model">budget.exceed</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
        <form string="Budget Exceed" delete="false">
                <header>
                <button string="Ask for Approval" name="ask_approve" states="draft" type="object" class="oe_highlight" modifiers="{'invisible': [['state', 'not in', ['draft']]]}"/>
                    <button string="Approve" name="approve" states="confirm" type="object" class="oe_highlight" modifiers="{'invisible': [['state', 'not in', ['confirm']]]}"/>
                    <button name="validate_exceed" string="Validate" type="object" attrs="{'invisible': [('state', '!=', 'validate')]}" class="oe_highlight" modifiers="{'invisible': [['state', '!=', 'validate']]}"/>
                    <button name="cancel_exceed" string="Cancel" type="object" attrs="{'invisible': [('state', '=', 'cancel')]}" class="oe_highlight" modifiers="{'invisible': [['state', '=', 'draft']]}"/>    
                    <button name="button_draft"  states="cancel" string="Set to Draft" type="object" modifiers="{'invisible': [['state', 'not in', ['cancel']]]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate,done" modifiers="{'readonly': true, 'required': true}"/>
                </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="user_id"/>
                                <field name="exceed_type"/>
                            </group>
                            <group>
                                <field name="company_id" />
                            </group>
                            <group string="Approval">
                                <group>
                                    <field name="type_id" domain="[('company_id','=',company_id)]" />
                                    <field name="approve_status" readonly="1"/>
                                    <field name="approved_bool" invisible="1"/>
                                    <field name="current_user_position" invisible="1"/>
                                    <field name="approve_next_store" readonly="0" invisible="1"/>
                                    <field name="remarks"/>
                                </group>
                                <group>
                                    <field name="approve_next" readonly="1"/>
                                    <field name="end_approval" readonly="1"/>
                                </group> 
                            </group>
                        </group>
                        <notebook>
                                <page string="Exceed Line" attrs="{'invisible': [('exceed_type', '!=', 'grn')]}">
                                    <field name="line_ids" context="{'default_exceed_id': id}" attrs="{'readonly': [('state', '=', 'done')]}">
                                        <tree editable="bottom">
                                            <field name="exceed_id" invisible="1"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="purchase_id" domain="[('company_id','=', company_id)]"/>
                                            <field name="purchase_line_id" string="PO Item" domain="[('order_id','=', purchase_id)]"/>
                                            <field name="picking_id" domain="[('po_id','=', purchase_id)]"/>
                                            <field name="move_id" domain="[('picking_id','=', picking_id),('state','!=', 'done')]"/>
                                            <field name="price_subtotal"/>
                                            <field name="price" invisible="1"/>
                                            <field name="quantity" invisible="1"/>
                                            <field name="analytic_account_id"/>
                                            <field name="budget_line_id" invisible="1"/>
                                            <field name="remaining_budget"/>
                                            <field name="exceed_budget"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Exceed PV Line" attrs="{'invisible': [('exceed_type', '!=', 'pv')]}">
                                    <field name="pv_line_ids" context="{'default_exceed_pv_id': id}"  attrs="{'readonly': [('state', '=', 'done')]}">
                                        <tree editable="bottom">
                                            <field name="exceed_pv_id" invisible="1"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="move_id" domain="[('company_id','=', company_id)]"/>
                                            <field name="move_line_id" domain="[('move_id','=', move_id),('analytic_account_id','!=', False)]"/>
                                            <field name="balance"/>
                                            <field name="analytic_account_id" readonly="0" required="0"/>
                                            <field name="account_id" readonly="0"/>
                                            <field name="budget_line_id" invisible="0"/>
                                            <field name="remaining_budget"/>
                                            <field name="exceed_budget"/>
                                        </tree>
                                    </field>
                                </page>
                                
                            </notebook>
                        
                    </sheet>
                </form>
            </field>
        </record>


