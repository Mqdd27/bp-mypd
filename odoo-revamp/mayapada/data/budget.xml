<odoo>
    <data>
        <record id="ir_cron_budget_refresh_chatter" model="ir.cron">
            <field name="name">Budget: post SQL refresh tracking</field>
            <field name="model_id" ref="model_eproc_budget_item"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_budget_refresh_tracking()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
        <record id="job_position_action" model="ir.actions.act_window">
            <field name="name">Job Position</field>
            <field name="res_model">res.position</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
        </record>

        <record id="mayapada_res_position_inherited" model="ir.ui.view">
            <field name="name">res.position.inherited</field>
            <field name="model">res.position</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Job Position" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="department_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Subordinates">
                                <field name="child_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="parent_id"/>
                                        <field name="department_id"/>
                                        <field name="sync_type"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Users">
                                <field name="user_ids"/>
                            </page>
                            <page string="Technical">
                                <group>
                                    <group>
                                        <field name="sync_type"/>
                                        <field name="sync_consol_log"/>
                                    </group>
                                    <group>
                                        <field name="sync_consol_id_unit" readonly="1"/>
                                        <field name="sync_consol_id_main" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>






