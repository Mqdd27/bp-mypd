        <record id="crossovered_budget_view_form_new2" model="ir.ui.view">
            <field name="name">Crossovered Budget Form</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="om_account_budget.crossovered_budget_view_form"/>
            <field name="arch" type="xml">
               <xpath expr="//form" position="replace">
                   <form string="Budget" delete="0">
                <header>
                    <button name="act_new" string="Next Fiscal Year" type="object"/>
                    <button name="budget_compute_balance" string="Compute Budget" type="object" />
                    <button string="Validate" name="action_budget_validate" states="draft" type="object" class="oe_highlight" />
                    <button string="Done" name="action_budget_done" states="validate" type="object" class="oe_highlight" />
                    <button string="Reset to Draft" name="action_budget_draft" states="cancel" type="object" />
                    <button string="Cancel Budget" name="action_budget_cancel" states="draft,confirm,validate" type="object" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate,done" />
                </header>
                <sheet string="Budget">
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="id" invisible="1"/>
                            <field name="company_id" />
                            <field name="parent_id" domain="[('company_id','=', company_id)]"/>
                            <field name="creating_user_id" />
                            <field name="year"/>
                            <label for="date_from" string="Period"/>
                            <div>
                                <field name="date_from" class="oe_inline" />
                                 - 
                                <field name="date_to" class="oe_inline"  nolabel="1" />
                            </div>
                            <field name="remarks"/>
                            <field name="type_id" domain="[('company_id','=',company_id)]" />
                        </group>
                        <group>
                            <field name="total_budget"/>          
                            <field name="remaining_budget"/>
                            <field name="remaining_amount" />
                            <field name="allocated_amount" />
                            <field name="used_percent" string="Already Spent" widget="progressbar" />
                            <field name="allocated_percent" widget="progressbar" />
                        </group>
                    </group>


                    <notebook>
                        <page string="Budget Lines">
                            <field name="crossovered_budget_line" context="{'default_crossovered_budget_id': id, 'default_date_from': date_from, 'default_date_to': date_to}" colspan="4" nolabel="1" attrs="{'readonly':[('state','!=','draft')]}" on_change="1" modifiers="{'readonly': [['state', '!=', 'draft']]}">
                                <tree>
                                    <field name="crossovered_budget_id" invisible="1"/>
                                    <field name="analytic_account_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="paid_date" invisible="1"/>
                                    <field name="planned_amount" string="Budget Planned" sum="Total" widget="monetary"/>
                                    <field name="exceed_amount" string="Budget Exceed" sum ="Total" widget="monetary"/>
                                    <field name="remain_amount" sum="Total" widget="monetary"/>
                                    <field name="actual_amount" sum="Total" widget="monetary"/>
                                    
                                    <field name="percent" invisible="1"/>
                                    <field name="actual_percent"/>
                                    
                                    <field name="other_amount" sum="Total" widget="monetary"/>
                                    <field name="paid_amount" sum="Total" widget="monetary"/>
                                    <field name="practical_amount" sum="Total" widget="monetary"/>
                                    <field name="grn_amount" sum="Total" widget="monetary"/>
                                    <field name="po_amount" sum="Total" widget="monetary"/>
                                    <field name="pr_amount" sum="Total" widget="monetary"/>
                                    <field name="trigger_create" invisible="0"/>
                                    <field name="trigger_write" invisible="0"/>
                                </tree>

                                <form string="Budget Lines">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="crossovered_budget_id" invisible="1"/>
                                                <field name="analytic_account_id"/>
                                                <field name="general_budget_id"/>
                                                <field name="date_from"/>
                                                <field name="date_to"/>
                                                <field name="paid_date"/>
                                            </group>
                                            <group>
                                                <field name="company_id" groups="base.group_multi_company"/>
                                                <field name="planned_amount" widget="monetary"/>
                                                <field name="remain_amount" widget="monetary"/>
                                                <field name="theoritical_amount" widget="monetary"/>
                                                <field name="percentage"/>
                                                <field name="exceed_amount"/>
                                            </group>
                                        </group>

                                        <notebook>
                                        <page string="PR Line">
                                            <field name="pr_line_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="requisition_id"/>
                                                <field name="price_subtotal"/>
                                            </tree>
                                            </field>
                                        </page>
                                        <page string="PO Line">
                                            <field name="po_line_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="order_id"/>
                                                <field name="price_subtotal"/>
                                            </tree>
                                            </field>
                                        </page>
                                        <page string="GRN">
                                            <field name="stock_move_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="name"/>
                                            </tree>
                                            </field>
                                        </page>
                                        <page string="Invoice Not Paid">
                                            <field name="invoice_line_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="invoice_id"/>
                                                <field name="price_subtotal"/>
                                            </tree>
                                            </field>
                                        </page>
                                        <page string="Invoice Paid">
                                            <field name="invoice_line_paid_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="invoice_id"/>
                                                <field name="price_subtotal"/>
                                            </tree>
                                            </field>
                                        </page>
                                        
                                        <page string="Other">
                                            <field name="other_ids" nolabel="1">
                                                <tree create="true" delete="true">
                                                <field name="move_id"/>
                                                <field name="debit"/>
                                            </tree>
                                            </field>
                                        </page>
                                         <page string="Technical">
                                            <group>
                                                <group>

                                                    <field name="sync_type"/>
                                                    <field name="sync_consol_id_main" readonly="1" />
                                                </group>
                                                <group>
                                                    <field name="sync_consol_id_unit" readonly="1" />
                                                    <field name="sync_consol_date" readonly="1"/>
                                                </group>
                                            </group>
                                        </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Budget Childs">
                            <field name="child_ids" />
                        </page>
                        <page string="Budget Member">
                            <field name="user_ids" can_create="true" can_write="true"/>
                        </page>
                        
                        <page string="Technical">
                            <group>
                                <group>
                                    <field name="no_approval"/>
                                    <field name="sync_type"/>
                                    <field name="sync_consol_id_main" readonly="1" />
                                </group>
                                <group>
                                    <field name="approve_id" readonly="1"/>
                                    <field name="approve_rule_id" readonly="1"/>
                                    <field name="sync_consol_id_unit" readonly="1" />
                                    <field name="sync_consol_date" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
               </xpath>
            </field>
        </record>





