<odoo>
    <data>
        <record model="ir.actions.act_window" id="cost_center_master_action">
                <field name="name">Cost Center Master</field>
                <field name="res_model">cost.center.master</field>
                <!-- <field name="view_type">form</field> -->
                <field name="view_mode">tree,form,pivot</field>
            </record>

       <record model="ir.actions.act_window" id="cost_center_import_action">
            <field name="name">Cost Center Import</field>
            <field name="res_model">cost.center.import</field>
            <field name="view_mode">tree,form,pivot</field>
        </record>


        <record model="ir.actions.act_window" id="cost_center_dimension_action">
            <field name="name">Cost Center Dimension</field>
            <field name="res_model">cost.center.dimension</field>
            <field name="view_mode">tree,form,pivot</field>
        </record>


    <record model="ir.actions.act_window" id="cost_center_sum_account_action">
            <field name="name">Cost Center Sum Account</field>
            <field name="res_model">cost.center.sum.account</field>
            <field name="view_mode">tree,form,pivot</field>
        </record>



        <record model="ir.actions.act_window" id="account_cost_center_report_wizard_action">
            <field name="name">Cost Center Report Wizard</field>
            <field name="res_model">cost.center.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

		<record id="mayapada_cost_center_master_inherited" model="ir.ui.view">
            <field name="name">cost.center.master.inherited</field>
            <field name="model">cost.center.master</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="CC Master" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="code"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="department_id" domain="[('is_user','=', 1)]" />
                                <field name="head_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Analytic Account">
                                <field name="analytic_ids" readonly="1" domain="[('type_analytic','=', 'expense'),('company_id','=', company_id)]">
                                    <tree editable="bottom">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="sync_wipro_type"/>
                                        <field name="type_analytic"/>
                                        <field name="company_id"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Technical">
                                <group>
                                    <group>
                                        <field name="sync_type" readonly="1"/>
                                        <field name="sync_consol_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="sync_consol_id_unit" readonly="1"/>
                                        <field name="sync_consol_id_main" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_master_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.master.tree.inherited</field>
            <field name="model">cost.center.master</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="CC Master" delete="false">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="head_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="mayapada_cost_center_master_search_inherited" model="ir.ui.view">
            <field name="name">cost.center.master.search.inherited</field>
            <field name="model">cost.center.master</field>
            <field name="arch" type="xml">
                <search string="Search Cost Center..">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="head_id"/>
                    <field name="company_id"/>
                </search>
            </field>
        </record>



		<record id="mayapada_cost_center_report_inherited" model="ir.ui.view">
            <field name="name">cost.center.report.inherited</field>
            <field name="model">cost.center.report</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Cost Center Report">
                    <sheet>
                        <group string="Information">
                            <group>
                                <field name="company_id"/>
                                <field name="type_report"/>
                                <field name="type_data"/>
                                <field name="date"/>
                                <field name="type_date"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="parent_pl_id"/>
                                <field name="pl_id"/>
                                <field name="pl_name"/>
                                <field name="sequence"/>                                
                            </group>
                        </group>
                        <group string="Cost Center">
                            <group>
                                <field name="move_id"/>
                                <field name="move_number"/>
                                <field name="cost_master_id"/>
                                <field name="department_id"/>
                                <field name="head_id"/>
                                <field name="account_id"/>
                                <field name="parent_analytic_id"/>
                                <field name="analytic_account_id"/>
                            </group>
                            <group>
                                <field name="budget_id"/>
                                <field name="budget_amount"/>
                                <field name="balance"/>
                                <field name="last_balance"/>
                                <field name="variance"/>
                                <field name="last_variance"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_report_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.report.tree.inherited</field>
            <field name="model">cost.center.report</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="Cost Center Report">
                    <field name="type_report"/>
                    <field name="type_data"/>
                    <field name="date"/>
                    <field name="type_date"/>
                    <field name="cost_master_id"/>
                    <field name="analytic_account_id"/>
                    <field name="balance"/>
                    <field name="last_balance"/>
                    <field name="budget_amount"/>
                    <field name="variance"/>
                </tree>
            </field>
        </record>


		<record id="mayapada_cost_center_import_inherited" model="ir.ui.view">
            <field name="name">cost.center.import.inherited</field>
            <field name="model">cost.center.import</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Cost Center Report (Import)">
                    <sheet>
                        <group string="Cost Center">
                            <group>
                                <field name="company_id"/>
                                <field name="cost_master_id" domain="[('company_id','=',company_id)]"/>
                                <field name="journal_id" domain="[('company_id','=',company_id)]"/>
                                <field name="account_id" domain="[('company_id','=',company_id)]"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="analytic_account_id" domain="[('company_id','=',company_id),('type_analytic','=','expense'),('cost_master_id','=',cost_master_id)]"/>
                                <field name="parent_analytic_id" readonly="1" domain="[('company_id','=',company_id)]"/>
                                <field name="balance"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Technical">
                                <group>
                                    <group>
                                        <field name="sync_type" readonly="1"/>
                                        <field name="sync_date" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="sync_consol_id_main" readonly="1" />
                                        <field name="sync_consol_id_unit" readonly="1" />
                                        <field name="sync_consol_date" readonly="1" />
                                    </group>
                                </group>
                            </page>
                            </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_import_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.import.tree.inherited</field>
            <field name="model">cost.center.import</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="Cost Center Report">
                    <field name="date"/>
                    <field name="cost_master_id"/>
                    <field name="analytic_account_id"/>
                    <field name="balance"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>



		<record id="mayapada_cost_center_reconcile_inherited" model="ir.ui.view">
            <field name="name">cost.center.reconcile.inherited</field>
            <field name="model">cost.center.reconcile</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Cost Center Reconcile">
                    <sheet>
                        <group string="Information">
                            <group>
                                <field name="company_id"/>
                                <field name="tglproses"/>
                                <field name="trans_type"/>
                                <field name="direction"/>
                                <field name="amount"/>
                            </group>
                            <group>
                                <field name="account_label"/>
                                <field name="account_credit_id"/>
                                <field name="account_debit_id"/>
                                <field name="doctor_id"/>                                
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="patient_group"/>
                                <field name="service_group"/>
                                <field name="service_name"/>
                                <field name="department_name"/>
                            </group>
                            <group>
                                <field name="cost_master_id"/>
                                <field name="analytic_id"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_reconcile_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.reconcile.tree.inherited</field>
            <field name="model">cost.center.reconcile</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="Cost Center Reconcile">
                    <field name="company_id"/>
                    <field name="tglproses"/>
                    <field name="user_id"/>
                    <field name="trans_type"/>
                    <field name="account_label"/>
                    <field name="analytic_id"/>
                </tree>
            </field>
        </record>



		<record id="mayapada_cost_center_dimension_inherited" model="ir.ui.view">
            <field name="name">cost.center.dimension.inherited</field>
            <field name="model">cost.center.dimension</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Cost Center Dimension" >
                
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id"/>
                <field name="dimension_type"/>
                <field name="sign_on_report"/>
                                
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="company_id" />
                            </group>
                        </group>
                        <notebook>
                <page string="Dimension Lines">
                                    <field name="line_ids" context="{'default_dimension_id': id}">
                                        <tree editable="bottom">
                        <field name="dimension_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="account_id"/>
                                            <field name="analytic_account_id"/>
                                            <field name="journal_id"/>
                        <field name="sign_on_report"/>
                        
                                            
                                            
                                        </tree>
                                    </field>
                                </page>


                                
                                <page string="Dimension Account">
                                    <field name="item_line_account_ids" domain="[('company_id','=', company_id)]">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            
                                            
                                            
                                        </tree>
                                    </field>
                                </page>

                                <page string="Dimension Analytic">
                                    <field name="item_line_analytic_ids" domain="[('company_id','=', company_id)]">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            
                                            
                                        </tree>
                                    </field>
                                </page>

                                <page string="Dimension Journal">
                                    <field name="item_line_journal_ids" domain="[('company_id','=', company_id)]">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            
                                            
                                        </tree>
                                    </field>
                                </page>
                                
                                
                            </notebook>
                        
                    </sheet>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_dimension_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.dimension.tree.inherited</field>
            <field name="model">cost.center.dimension</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="Cost Center Dimension" >
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="company_id" />
                </tree>
            </field>
        </record>



		<record id="mayapada_cost_center_sum_account_inherited" model="ir.ui.view">
            <field name="name">cost.center.sum.account.inherited</field>
            <field name="model">cost.center.sum.account</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Sum Account Cost Center">
                
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id"/>
                				<field name="dimension_type"/>
                                
                            </group>
                            <group>
                                <field name="analytic_account_id"/>
                                <field name="balance"/>
                                <field name="journal_id"/>
                                <field name="account_id" />
                            </group>
                        </group>
                        
                        
                    </sheet>
                </form>
            </field>
        </record>


        <record id="mayapada_cost_center_sum_account_tree_inherited" model="ir.ui.view">
            <field name="name">cost.center.sum.account.tree.inherited</field>
            <field name="model">cost.center.sum.account</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <tree string="Sum Account Cost Center">
                    <field name="journal_id"/>
                    <field name="analytic_account_id"/>
                    <field name="account_id" />
                                <field name="balance"/>
                                
                                
                    <field name="company_id" />
                </tree>
            </field>
        </record>



		<record id="mayapada_cost_center_report_wizard_inherited" model="ir.ui.view">
            <field name="name">cost.center.report.wizard.inherited</field>
            <field name="model">cost.center.report.wizard</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Report Options" class="oe_form_configuration">
                    <sheet>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="cost_center_user_ids" invisible="1"/>
                                <field name="analytic_account_user_ids" invisible="1"/>
                                <field name="company_id" widget="selection"/>
                                <field name="type_report" widget="selection"/>
                                <field name="reconcile_type" attrs="{'invisible':[('type_report','!=','4')], 'required':[('type_report','=','4')]}"/>                        
                            </group>
                            <group>
                                <field name="type_period"/>
                                <field name="date_start" attrs="{'invisible':[('type_period','!=','PERIOD')], 'required':[('type_period','=','PERIOD')]}"/>
                                <field name="date_end" required="1"/>
                                <field name="state" attrs="{'invisible':[('type_report','=','4')]}"/>
                                <field name="type_filter" attrs="{'invisible':[('type_report','=','4')]}"/>
                            </group>
                        </group>
                            
                        <field name="cost_center_ids" nolabel="1" attrs="{'invisible':['|',('type_filter','!=','1'),('type_report','=','4')]}">
                            <tree>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="company_id"/>
                            </tree>
                        </field>
                           
                        <field name="analytic_account_ids" nolabel="1" domain="[('company_id','=',company_id)]" attrs="{'invisible':['|',('type_filter','!=','2'),('type_report','=','4')]}">
                            <tree>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="company_id"/>
                            </tree>
                        </field>
                           
                    </sheet>
                    <footer>
                        <button name="show_report" string="View Report" type="object" attrs="{'invisible':[('type_report','=','4')]}"/>
                        <button name="print_report_xls" string="Print Excel" type="object" attrs="{'invisible':[('type_report','=','4')]}"/>
                        <button name="print_report_pdf" string="Print PDF" type="object" attrs="{'invisible':[('type_report','=','4')]}"/>
                        <button name="reconcile_report" string="Reconcile" type="object" attrs="{'invisible':[('type_report','!=','4')]}"/>
                    </footer>
                </form>
            </field>
        </record>



    </data>
</odoo>