                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="marketing_rate_pic_action">
            <field name="name">Rate of PIC Fee</field>
            <field name="res_model">marketing.rate.pic</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record id="mayapada_marketing_rate_pic_view" model="ir.ui.view">
            <field name="name">marketing.rate.pic.view</field>
            <field name="model">marketing.rate.pic</field>
            <field name="inherit_id" />
