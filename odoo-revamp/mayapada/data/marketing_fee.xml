        <record model="ir.actions.act_window" id="marketing_posting_action">
            <field name="name">Posting Fee to Journal Entries</field>
            <field name="res_model">marketing.posting.wizard</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="mayapada_marketing_posting_wizard_view" model="ir.ui.view">
            <field name="name">marketing.posting.wizard.view</field>
            <field name="model">marketing.posting.wizard</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Posting Marketing Fee to Entries">
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="year" />
                            <field name="month" />
                            <field name="posting_type" />
                            <field name="auto_posting" />
                        </group>
                        <group>
                            <field name="expense_journal_id" domain="[('company_id', '=', company_id)]" />
                            <field name="expense_date" />
                            <field name="expense_account_id" domain="[('company_id', '=', company_id)]" />
                            <field name="credit_account_id" domain="[('company_id', '=', company_id)]" />
                            <field name="tax_account_id" domain="[('company_id', '=', company_id),('code', 'like', '2104%')]" />
                        </group>
