        <record model="ir.actions.act_window" id="marketing_fee_action">
            <field name="name">Marketing Fee</field>
            <field name="res_model">marketing.fee</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record id="mayapada_marketing_fee_view" model="ir.ui.view">
            <field name="name">marketing.fee.view</field>
            <field name="model">marketing.fee</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Marketing Fee" delete="false">
                    <header>
                            <button string="Compute Bruto" name="compute_bruto" type="object" class="oe_highlight" states="draft"/>
                            <button string="PDF" name="action_print" type="object" class="oe_highlight" />
                            <button string="Confirm" name="confirm" type="object" class="oe_highlight" states="draft"/>
                            <button string="Unconfirm" name="unconfirm" type="object" class="oe_highlight" states="confirm"/>
                            <button string="Unpost" name="unpost" type="object" class="oe_highlight" states="posted"/>
                            <button string="Cancel" name="cancel" type="object" class="oe_highlight" states="confirm"/>
                            <button string="Set Draft" name="set_draft" type="object" class="oe_highlight" states="cancel"/>
                            <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="employee_id" domain="[('company_id', '=', company_id)]" />
                                <field name="position_id"/>
                                <field name="sales_id"/>
                                <field name="employee_level"/>
                                <field name="year"/>
                                <field name="month"/>
                                <field name="remark"/>
                            </group>
                            <group>
                                <field name="gross_fee"/>
                                <field name="addition"/>
                                <field name="total_fee"/>
                                <field name="total_dpp"/>
                                <field name="total_dpp_50"/>
                                <field name="total_pph"/>
                                <field name="deduction"/>
                                <field name="thp"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Fee Line">
                                <field name="fee_line_ids" readonly="1">
                                    <tree>
                                        <field name="bill_no"/>
                                        <field name="bill_date"/>
                                        <field name="payer_name"/>
                                        <field name="payer_id" invisible="1"/>
                                        <field name="payer_new" invisible="1" />
                                        <field name="nett_marketing"/>
                                        <field name="old_incentive" invisible="1"/>
                                        <field name="old_sharing"/>
                                        <field name="old_rate"/>
                                        <field name="old_amount" sum="Total" widget="monetary"/>

                                        <field name="new_direct"/>
                                        <field name="new_incentive" invisible="1"/>
                                        <field name="new_sharing"/>
                                        <field name="new_rate"/>
                                        <field name="new_amount" sum="Total" widget="monetary"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Additional">
                                <field name="fee_addition_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Deduction">
                                <field name="fee_deduction_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Direct Sales">
                                <field name="billing_ids" readonly="1" />
                            </page>

                            <page string="Information">
                                <group>
                                    <group>
                                        <field name="is_npwp"/>
                                        <field name="npwp"/>
                                        <field name="pph"/>
                                    </group>
                                    <group>
                                        <field name="previous_dpp"/>
                                        <field name="previous_pph"/>
                                        <field name="journal_id"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Technical">
                                <group>
                                    <group>
                                        <field name="sync_type"/>
                                        <field name="sync_consol_id_main" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="sync_consol_id_unit" readonly="1" />
                                        <field name="sync_consol_date" readonly="1" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>

