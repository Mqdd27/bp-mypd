<odoo>
    <data>
        <record model="ir.actions.act_window" id="marketing_position_action">
            <field name="name">Position</field>
            <field name="res_model">marketing.position</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
            <!-- <field name="domain">[('company_id', '=', 'supplier')]</field> -->
        </record>

        <record model="ir.actions.act_window" id="marketing_sales_action">
            <field name="name">Sales Type</field>
            <field name="res_model">marketing.sales</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record model="ir.actions.act_window" id="marketing_employee_action">
            <field name="name">Marketing Employee</field>
            <field name="res_model">marketing.employee</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record id="mayapada_marketing_employee_view" model="ir.ui.view">
            <field name="name">marketing.employee.view</field>
            <field name="model">marketing.employee</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Marketing Employee">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="gender"/>
                                <field name="position_id"/>
                                <field name="sales_id" domain="[('position_id','=',position_id),('company_id','=',company_id)]"/>
                                <field name="address"/>
                                <field name="phone"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                                <field name="is_npwp"/>
                                <field name="npwp"/>
                                <field name="pph"/>
                                <field name="bank_name"/>
                                <field name="bank_branch"/>
                                <field name="bank_account"/>
                                <field name="bank_client"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Employee to Company for Direct Sales Staff Only">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="payor_id" domain="[('company_id','=',parent.company_id),('insurance','=',True)]"/>
                                        <field name="payor_code"/>
                                        <field name="payor_type"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="marketing_rate_action">
            <field name="name">Rate of Marketing Fee</field>
            <field name="res_model">marketing.rate</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record id="mayapada_marketing_rate_view" model="ir.ui.view">
            <field name="name">marketing.rate.view</field>
            <field name="model">marketing.rate</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Rate Configuration">
                    <sheet>
                        <div class="oe_title">
                            <label for="company_id" string="Company"/>
                            <h1>
                                <field name="company_id" nolabel="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Incentive Old Customer">
                                <group>
                                    <group>
                                        <field name="rate"/>
                                    </group>
                                </group>

                                <!-- <group>
                                    <label>
                                        Setup besar incentive untuk customer lama, tentukan berapa presentase dari pendapatan (diluar jasa dokter) per bulan.
                                    </label>
                                </group> -->
                            </page>

                            <page string="Incentive New Customer">
                                <field name="new_rate_ids">
                                    <tree editable="bottom"> 
                                        <field name="sequence"/>
                                        <field name="range_min"/>
                                        <field name="range_max"/>
                                        <field name="rate"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Dividen for Customer">
                                <field name="dividen_ids">
                                    <tree editable="bottom">
                                        <field name="sales_id"/>
                                        <field name="sales_code"/>
                                        <field name="is_direct"/>
                                        <field name="sales_position"/>
                                        <field name="rate_old"/>
                                        <field name="rate_new"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Exception Companies">
                                <field name="exception_ids">
                                    <tree editable="bottom">
                                        <field name="payor_id" domain="[('company_id','=',parent.company_id),('insurance','=',True)]"/>
                                        <field name="payor_code"/>
                                        <field name="payor_type"/>
                                    </tree>
                                </field>
                            </page>

                                <page string="Exception Company Types">
                                <field name="exception_type_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                    </sheet>

                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="marketing_rate_personal_action">
            <field name="name">Rate of Personal Fee</field>
            <field name="res_model">marketing.rate.personal</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
        </record>

        <record id="mayapada_marketing_rate_personal_view" model="ir.ui.view">
            <field name="name">marketing.rate.personal.view</field>
            <field name="model">marketing.rate.personal</field>
            <field name="inherit_id" />
            <field name="arch" type="xml">
                <form string="Rate of Personel Fee">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="payer_name"/>
                                <field name="fee_percent"/>
                                <field name="remark"/>
                            </group>
                            <group>    
                                <field name="company_id"/>
                                <field name="is_npwp"/>
                                <field name="npwp"/>
                                <field name="pph"/>
                                <field name="active"/>
