<odoo>
    <data>
        <record id="view_category_property_form" model="ir.ui.view">
            <field name="name">product.category.stock.property.form.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="account.view_category_property_form"/>
            <field name="arch" type="xml">
                <group name="account_property" position="inside">
                    <group name="account_stock_property" string="Account Stock Properties">
                        <field name="property_stock_account_input_categ_id" domain="[('deprecated', '=', False)]"/>
                        <field name="property_stock_account_output_categ_id" domain="[('deprecated', '=', False)]"/>
                        <field name="property_stock_valuation_account_id" domain="[('deprecated', '=', False)]"/>
                        <field name="property_stock_journal"/>
                    </group>
                </group>
                <group name="account_property" position="before">
                    <group>
                        <group string="Inventory Valuation">
                            <field name="property_cost_method" groups="stock_account.group_inventory_valuation"/>
                            <field name="property_valuation"/>
                        </group>
                    </group>
                </group>
            </field>
        </record>
        
        <record id="mayapada_product_category_tree" model="ir.ui.view">
            <field name="name">Product Category</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_list_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree string="Product Category" delete="false">
                        <field name="display_name" />
                        <!--field name="name" /-->
                        <field name="parent_id" />
                        <field name="company_id" />
                        <field name="sync_type" />
                        <field name="stock_output_id" />
                    </tree>
                </xpath>
            </field>
        </record>

        <record id="mayapada_product_category_inherited" model="ir.ui.view">
            <field name="name">product.category.inherited</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position='attributes'>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//field[@name='property_account_expense_categ_id']" position="after">
                    <field name="property_account_accrual_id" string="Accrual Account" nolabel="0"/>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="lob_los" string="LOB / LOS"/>
                    <field name="company_id" string="Company"/>
                    <field name="active" string="Active"/>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Journal Matic">
                            <group>
                                <group>
                                    <field name="parent_sync_id"/>
                                    <field name="stock_input_id"/>
                                    <field name="stock_output_id"/>
                                    <field name="stock_valuation_id"/>
                                    <field name="income_account_id"/>
                                    <field name="expense_account_id"/>
                                    <field name="stock_journal_id"/>
                                </group>
                                <group>
                                    <field name="sync_is_service"/>
                                    <field name="sync_is_surgery"/>
                                    <field name="sync_is_category"/>
                                    <field name="sync_is_specialist"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sub Category">
                            <field name="child_ids" readonly="1"/>
                        </page>
                        <page string="Technical">
                            <group>
                                <group>
                                    <field name="trigger_create" invisible="1"/>
                                    <field name="trigger_write" invisible="1"/>
                                    <field name="sync_type"/>
                                    <field name="sync_date"/>
                                    <field name="sync_id"/>
                                </group>
                                <group>
                                    <field name="sync_id_api"/>
                                    <field name="sync_consol_id_unit"/>
                                    <field name="sync_consol_id_main"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
                <xpath expr="//field[@name='sync_is_service']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_sync_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <record id="mayapada_product_template_search" model="ir.ui.view">
            <field name="name">product.template.search</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view" />
            <field name="arch" type="xml">
                <xpath expr="//search/filter[@name='inactive']" position="after">
                    <filter string="From Arcus" name="sync_is_arcus" domain="[('sync_is_arcus','=',True)]" help="From Arcus"/>
                </xpath>
            </field>
        </record>
        

        <record id="mayapada_product_template_inherited" model="ir.ui.view">
            <field name="name">product.template.inherited</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position='attributes'>
                    <attribute name="delete">0</attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <!--button name="update_bp_manual" string="Update Base Price Manual" type="object" attrs="{'invisible':[('id','=',False)]}" class="oe_highlight"/-->
                </xpath>

                <!-- <xpath expr="//field[@name='default_code']" position="after"> -->
                <xpath expr="//sheet/notebook/page/group/group/field[@name='detailed_type']" position="after">
                    <field name="catalog_code" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="manufacturer_code" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="manufacturer" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="brand" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="shelf" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="mims_ref" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="mims_type" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="consignment" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                    <field name="is_pr_item" attrs="{'invisible' : [('sale_ok', '=', False)]}"/>
                </xpath>

                <xpath expr="//sheet/notebook/page/group/group/div/field[@name='list_price']" position="before">
                    <field name="property_cost_method" attrs="{'invisible' : [('type', '!=', 'product')]}"/>
                    <field name="cost_method" readonly="1" attrs="{'invisible' : [('type', '!=', 'product')]}"/>
                    <field name="property_valuation" attrs="{'invisible' : [('type', '!=', 'product')]}"/>
                    <field name="valuation" readonly="1" attrs="{'invisible' : [('type', '!=', 'product')]}"/>
                    <field name="base_price"/>
                    <field name="base_price_manual" attrs="{'invisible' : [('base_price_manual_active', '=', False)]}"/>
                    <field name="base_price_manual_active"/>
                </xpath>

                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="service_group_id" domain="[('company_id','=',company_id)]"/>
                    <field name="asset_category_id" domain="[('company_id','=',company_id)]" attrs="{'invisible' : [('type', '!=', 'product')]}"/>

                    <field name="company_id"/>
                    <field name="uom_id" domain="[('company_id','=',company_id)]"/>
                    <field name="uom2_id" domain="[('company_id','=',company_id)]"/>
                    <field name="conversion_rate"/>
                </xpath>

                <xpath expr="//form/sheet/notebook/page[1]" position="after">
                    <page string="Medical" attrs="{'invisible' : [('sale_ok', '=', False)]}">
                        <group>
                            <group>
                                <field name="pharmacalogy" />
                                <field name="strength" />
                                <field name="narcotic" />
                            </group>
                            <group>
                                <field name="generic" />
                                <field name="psychotropic" />
                                <field name="antibiotic" />
                            </group>
                        </group>
                    </page>

                    <page string="Base Price">
                        <field name="base_price_manual_ids" nolabel="1">
                            <tree>
                                <field name="price"/>
                                <field name="price_before"/>
                                <field name="input_timestamp"/>
                            </tree>
                        </field>
                    </page>
                    
                    <page string="Cost Price">
                        <field name="price_history_ids" nolabel="1">
                            <form>
                                <group>
                                    <group>
                                        <field name="company_id"/>
                                        <field name="product_tmpl_id"/>
                                    </group>
                                    <group>
                                        <field name="datetime"/>
                                        <field name="cost"/>
                                    </group>
                                </group>
                            </form>
                            <tree>
                                <field name="datetime"/>
                                <field name="product_tmpl_id"/>
                                <field name="product_id"/>
                                <field name="cost"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Stock Income">
                        <field name="product_income_ids" nolabel="1">
                            <form>
                                <group>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="move_id"/>
                                        <field name="move_type"/>
                                        <field name="order_no"/>
                                    </group>
                                    <group>
                                        <field name="stock_in_date"/>
                                        <field name="stock_in_qty"/>
                                        <field name="stock_in_uom"/>
                                        <field name="stock_in_price"/>
                                    </group>
                                </group>
                            </form>
                            <tree>
                                <field name="move_id"/>
                                <field name="move_type"/>
                                <field name="order_no"/>
                                <field name="stock_in_date"/>
                                <field name="stock_in_qty"/>
                                <field name="stock_in_uom"/>
                                <field name="stock_in_price"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Substore">
                        <field name="substore_ids" nolabel="1"/>
                            <tree>

                            </tree>
                    </page>

                    <page string="Rack">
                        <field name="product_rack_ids" nolabel="1">
                            <tree>
                                <field name="location_id"/>
                                <field name="rack_id"/>
                                <field name="shelf_id"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//form/sheet/notebook/page[10]" position="after">
                    <page string="API Post" name="api_post_api">
                        <group>
                            <group>
                                <field name="api_post_timestamp"/>
                                <field name="api_post_status"/>
                                <field name="api_post_payload"/>
                                <field name="api_post_response"/>
                                <field name="api_post_url"/>
                                <field name="api_post_key"/>
                            </group>
                            <group>
                                <!-- <button string="Resend" type="object" name="update_best_price_api" attrs="{'invisible':['|',('api_post_status','=','done'),('api_post_status','=',False)]}" class="oe_highlight"/> -->
                            </group>
                        </group>
                    </page>

                    <page string="Technical">
                        <group>
                            <group>
                                <field name="sync_type"/>
                                <field name="sync_date"/>
                                <field name="sync_id_api" readonly="1"/>
                                <field name="sync_id" readonly="1"/>
                                <field name="sync_is_package"/>
                                <field name="sync_is_service"/>
                                <field name="sync_categ_id"/>
                            </group>
                            <group>
                                <field name="trigger_create" invisible="1"/>
                                <field name="trigger_write" invisible="1"/>
                                <field name="sync_consol_id_main" readonly="1"/>
                                <field name="sync_consol_id_unit" readonly="1"/>
                                <field name="sync_consol_date" readonly="1" />
                            </group>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='detailed_type']" position="after">
                    <field name="default_code" string ="Product Code"/>
                </xpath>
                <xpath expr="//field[@name='sync_is_package']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='sync_is_service']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='sync_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='sync_date']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='sync_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='sync_categ_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='uom_po_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="after">
                    <!-- <field name="uom_id"/> -->
                    <!-- <field name="uom2_id"/> -->
                    <!-- <field name="conversion_rate" attrs="{'invisible' : [('sale_ok', '=', False)]}"/> -->
                </xpath>

                <xpath expr="//form/sheet" position="after">
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </xpath>

                <xpath expr="//form/div[@class='oe_chatter']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="mayapada_uom_uom_inherited" model="ir.ui.view">
            <field name="name">uom.uom.inherited</field>
            <field name="model">uom.uom</field>
            <field name="inherit_id" ref="uom.product_uom_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="replace">
                    <form string="Units of Measure" delete="0">
                        <sheet>
                            <group>
                                <group>
                                    <field name="name" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="category_id" on_change="1" can_create="true" can_write="true" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="uom_type" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="factor" digits="[42,5]" attrs="{&quot;invisible&quot;:[(&quot;uom_type&quot;,&quot;!=&quot;,&quot;smaller&quot;)], &quot;readonly&quot;:[(&quot;uom_type&quot;,&quot;=&quot;,&quot;bigger&quot;)]}" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;uom_type&quot;, &quot;!=&quot;, &quot;smaller&quot;]], &quot;readonly&quot;: [[&quot;uom_type&quot;, &quot;=&quot;, &quot;bigger&quot;]], &quot;required&quot;: true}"/>
                                    <field name="factor_inv" digits="[42,5]" attrs="{&quot;invisible&quot;:[(&quot;uom_type&quot;,&quot;!=&quot;,&quot;bigger&quot;)], &quot;readonly&quot;:[(&quot;uom_type&quot;,&quot;!=&quot;,&quot;bigger&quot;)]}" on_change="1" modifiers="{&quot;invisible&quot;: [[&quot;uom_type&quot;, &quot;!=&quot;, &quot;bigger&quot;]], &quot;readonly&quot;: [[&quot;uom_type&quot;, &quot;!=&quot;, &quot;bigger&quot;]], &quot;required&quot;: true}"/>
                                    <p attrs="{&quot;invisible&quot;:[(&quot;uom_type&quot;,&quot;!=&quot;,&quot;smaller&quot;)]}" class="oe_grey" colspan="2" modifiers="{&quot;invisible&quot;: [[&quot;uom_type&quot;, &quot;!=&quot;, &quot;smaller&quot;]]}">
                                
                                            e.g: 1 * (reference unit) = ratio * (this unit)
                                        
                                    </p>
                                    <p attrs="{&quot;invisible&quot;:[(&quot;uom_type&quot;,&quot;!=&quot;,&quot;bigger&quot;)]}" class="oe_grey" colspan="2" modifiers="{&quot;invisible&quot;: [[&quot;uom_type&quot;, &quot;!=&quot;, &quot;bigger&quot;]]}">
                                        
                                                    e.g: 1 * (this unit) = ratio * (reference unit)
                                                
                                    </p>
                                </group>
                                <group>
                                    <field name="active" on_change="1" modifiers="{}"/>
                                    <field name="rounding" digits="[42, 5]" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                                    <field name="company_id" can_create="true" can_write="true" modifiers="{}"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Technical">
                                    <group>
                                        <group>
                                            <field name="trigger_create" invisible="1" modifiers="{&quot;invisible&quot;: true}"/>
                                            <field name="trigger_write" invisible="1" modifiers="{&quot;invisible&quot;: true}"/>
                                            <field name="sync_type" readonly="1"/>
                                            <field name="sync_id" readonly="1"/>
                                            <field name="sync_id_api" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="sync_consol_id_main" readonly="1"/>
                                            <field name="sync_consol_id_unit" readonly="1"/>
                                            <field name="sync_consol_date" readonly="1"/>
                                        </group>
                                    </group>
                                </page>
                            </notebook>
                        </sheet>
                    </form>
                </xpath>
            </field>
        </record>

        <record id="mayapada_uom_uom_tree" model="ir.ui.view">
            <field name="name">Units of Measure</field>
            <field name="model">uom.uom</field>
            <field name="inherit_id" ref="uom.product_uom_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree string="Units of Measure" delete="0">
                        <field name="name" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                        <field name="wipro_block" modifiers="{}"/>
                        <field name="sync_type" on_change="1" modifiers="{}"/>
                        <field name="trigger_create" invisible="1" modifiers="{&quot;tree_invisible&quot;: true}"/>
                        <field name="trigger_write" invisible="1" modifiers="{&quot;tree_invisible&quot;: true}"/>
                        <field name="category_id" on_change="1" can_create="true" can_write="true" modifiers="{&quot;required&quot;: true}"/>
                        <field name="uom_type" on_change="1" modifiers="{&quot;required&quot;: true}"/>
                    </tree>
                </xpath>
            </field>
        </record>

        <record id="uom_uom_search_inherited_view" model="ir.ui.view">
            <field name="name">uom.uom.search.inherited</field>
            <field name="model">uom.uom</field>
            <field name="inherit_id" ref="uom.uom_uom_view_search" />
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="after">
                    <filter name="sync_is_arcus" string="From Arcus" domain="[('sync_is_arcus','=', 1)]" help="From Arcus"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>