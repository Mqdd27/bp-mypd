<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="web_qrcode_scan_assets_backend"
              name="web_qrcode_scan assets"
              inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript"
                    src="/web_qrcode_custom/static/src/lib/jquery.timepicker/jquery.timepicker.js"/>
            <script type="text/javascript"
                    src="/web_qrcode_custom/static/src/lib/jquery.timepicker/ZXing.js"/>
            <script type="text/javascript"
                    src="/web_qrcode_custom/static/src/js/web_qrcode_custom.js"/>
            <link rel="stylesheet"
                  href="/web_qrcode_custom/static/src/lib/jquery.timepicker/jquery.timepicker.css"/>
            <link rel="stylesheet" type="text/scss" 
                  href="/web_qrcode_custom/static/src/scss/qr.scss"/>
            <link rel="stylesheet"
                  href="/web_qrcode_custom/static/src/css/web_widget_timepicker.css"/>
        </xpath>
    </template>
</odoo>
